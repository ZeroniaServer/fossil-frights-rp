{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:component",
    "predicate": "minecraft:custom_data",
    "value": {
      "ff_invisible": true
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": "thirdperson_righthand",
          "model": {
            "type": "minecraft:empty"
          }
        },
        {
          "when": "thirdperson_lefthand",
          "model": {
            "type": "minecraft:empty"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:custom_model_data",
        "index": 0,
        "entries": [
          {
            "threshold": 0.4,
            "model": {
              "type": "minecraft:model",
              "model": "fossil_frights:items/frights/hard_items/lady_bug/slow_flap"
            }
          },
          {
            "threshold": 0.6,
            "model": {
              "type": "minecraft:model",
              "model": "fossil_frights:items/frights/hard_items/lady_bug/medium_flap"
            }
          },
          {
            "threshold": 0.8,
            "model": {
              "type": "minecraft:model",
              "model": "fossil_frights:items/frights/hard_items/lady_bug/fast_flap"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "fossil_frights:items/frights/hard_items/lady_bug/very_fast_flap"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "fossil_frights:items/frights/hard_items/lady_bug"
        }
      }
    },
    "on_false": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "entries": [
        {
          "threshold": 0.4,
          "model": {
            "type": "minecraft:model",
            "model": "fossil_frights:items/frights/hard_items/lady_bug/slow_flap"
          }
        },
        {
          "threshold": 0.6,
          "model": {
            "type": "minecraft:model",
            "model": "fossil_frights:items/frights/hard_items/lady_bug/medium_flap"
          }
        },
        {
          "threshold": 0.8,
          "model": {
            "type": "minecraft:model",
            "model": "fossil_frights:items/frights/hard_items/lady_bug/fast_flap"
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:model",
            "model": "fossil_frights:items/frights/hard_items/lady_bug/very_fast_flap"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "fossil_frights:items/frights/hard_items/lady_bug"
      }
    }
  },
  "hand_animation_on_swap": false
}