{
  "multipart": [
    {
      "apply": {
        "model": "fossil-frights:block/railing_post"
      }
    },
    {
      "apply": {
        "model": "fossil-frights:block/railing_side_alt"
      },
      "when": {
        "OR": [
          {
            "north": "low"
          },
          {
            "north": "tall"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "fossil-frights:block/railing_side_alt",
        "y": 90
      },
      "when": {
        "OR": [
          {
            "east": "low"
          },
          {
            "east": "tall"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "fossil-frights:block/railing_side",
        "y": 180
      },
      "when": {
        "OR": [
          {
            "south": "low"
          },
          {
            "south": "tall"
          }
        ]
      }
    },
    {
      "apply": {
        "model": "fossil-frights:block/railing_side",
        "y": 270
      },
      "when": {
        "OR": [
          {
            "west": "low"
          },
          {
            "west": "tall"
          }
        ]
      }
    }
  ]
}